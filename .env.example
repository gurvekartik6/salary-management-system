NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
AUDIT_IP_SALT=replace-with-a-separate-random-salt
MONGODB_URI=mongodb://127.0.0.1:27017/sggs_salary_notifications
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
MONGO_ROOT_USERNAME=sggsroot
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=sggsapp
MONGO_APP_PASSWORD=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=sggs.sid
SESSION_MAX_AGE_HOURS=8
ADMIN_MFA_REQUIRED=true
MFA_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
COLLEGE_EMAIL_DOMAIN=sggs.ac.in
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
PRIVATE_UPLOAD_DIR=./server/private-uploads
PRIVATE_REPORT_DIR=./server/private-reports
PUBLIC_ASSET_DIR=./server/public-assets
MAX_UPLOAD_MB=20
UPLOAD_RETENTION_DAYS=90
REPORT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
BACKUP_RETENTION_DAYS=35
BACKUP_DIR=./private-backups
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_DAILY_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=Asia/Kolkata
# Required in production: configure an approved rclone remote in the secret store. Example: s3:sggs-backups/production
BACKUP_RCLONE_REMOTE=
SENSITIVE_CAMPAIGN_RETENTION_DAYS=90
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMS adapter: Twilio API; confirm Indian sender/DLT requirements and replace adapter if required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
SMS_SENDER_ID=
# WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
EMAIL_WEBHOOK_SECRET=
# OCR: set TESSERACT_PATH if not on PATH; install Tesseract on host/container.
TESSERACT_PATH=tesseract
OCR_LANGUAGES=eng+mar+hin
# Cost estimates; replace with contract pricing.
EMAIL_COST_PER_MESSAGE=0
SMS_COST_PER_SEGMENT=0
WHATSAPP_COST_PER_MESSAGE=0
